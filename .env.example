# Copy to .env and fill values locally. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/fire_guard.db
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for first administrator creation; no default password is provided.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
DEVICE_STALE_SECONDS=10
DEVICE_OFFLINE_SECONDS=30
TELEMETRY_MAX_AGE_SECONDS=10
CLOCK_SKEW_SECONDS=10
DEMO_ENABLED=false
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=600
DEVICE_RATE_LIMIT=120
AI_URL=http://127.0.0.1:5000/detect
AI_TIMEOUT_MS=5000
AI_MAX_FRAME_AGE_MS=5000
AI_HOLD_MS=10000
# npm run start:ai passes .env to Python; running python directly does not.
# restricted: known-class weights-only loading; never unrestricted fallback.
# trusted: requires the explicit trusted hash after source/code review.
AI_MODEL_LOAD_MODE=restricted
# Leave trust hash blank until checkpoint origin/code safety have been reviewed.
AI_MODEL_PATH=./ai/best.pt
AI_TRUSTED_MODEL_SHA256=
# Experimental score cutoff, NOT a measured accuracy or calibrated probability.
AI_CONFIDENCE_THRESHOLD=0.15
# For LAN access: set HOST=0.0.0.0 and add the exact dashboard origin to APP_ORIGINS.
# Production requires HTTPS origins and COOKIE_SECURE=true; terminate TLS at a trusted proxy.
